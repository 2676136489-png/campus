# 运行环境：development / production
APP_ENV=development

# 数据库配置
DB_HOST=127.0.0.1
DB_NAME=circle
DB_USER=root
DB_PASS=123456
DB_PORT=3306

# 初始管理员密码（首次登录后必须修改）
ADMIN_INITIAL_PASSWORD=Admin@123456
LOGIN_RATE_IP_FAILURES=20
LOGIN_RATE_NAME_FAILURES=10

# 登录邮箱验证码二步验证
# MAIL_TRANSPORT: smtp / log / none
# 三通道都不通时 LOGIN_EMAIL_OTP_ENABLED 会被强制关闭，登录降级为直登
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
LOGIN_EMAIL_OTP_ENABLED=0

# AI 助手（Dify 控制台 → API 访问 → 生成密钥）
# Endpoint 以控制台「访问 API」页显示为准
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_ADMIN_API_KEY=
# 供 Dify 工具调用的站内数据接口密钥（工具弹窗用请求头 X-API-Key 传）
AI_API_KEY=
AI_ADMIN_API_KEY=
