# ============================================================
# 安全基线：禁止直接访问源码、配置、日志、迁移脚本
# 仅当 Apache 已加载 authz_core / alias / headers 时生效，缺失模块会安全跳过
# ============================================================

# 1) 敏感文件按文件名拦截
<IfModule mod_authz_core.c>
    <FilesMatch "(^\.|^composer\.(phar|json|lock)$|^Dockerfile$|^docker-compose\.yml$|^package(-lock)?\.json$|^phpunit\.xml$|^phpstan\.neon\.dist$|^playwright\.config\.js$|\.(log|sql|ini|lock|neon|dist|bak|old|swp|tar|gz|zip)$)">
        Require all denied
    </FilesMatch>
</IfModule>

# 2) 内部目录整目录拦截
<IfModule mod_alias.c>
    RedirectMatch 403 ^/(bin|tests|docs|deploy|migrations|scripts|benchmark|config|lib|var|\.git)(/|$)
    RedirectMatch 403 ^/p_(dbInfo|manageDB)\.php$
</IfModule>

# 3) 关闭目录列表
Options -Indexes

# 4) 静态资源压缩
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# 5) 静态资源长缓存（前端用 ?v= 版本号刷新，可放心设长）
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
